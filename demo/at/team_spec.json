{
  "team": {
    "name": "reimburse-zero-demo",
    "version": "0.1.0",
    "description": "Minimal AgentTeams expense-claim audit and disposal demo for GOAI initial round.",
    "primary_runtime": "agentteams-real-llm",
    "worker_runtime": "qwenpow(copow/QwenPaw)",
    "creation_policy": {
      "mode": "serial",
      "order": ["intake", "audit_analyst", "risk_rater", "executor", "reviewer", "team"],
      "rule": "Create the next business Worker only after the previous Worker is created and verified healthy. During Team creation, manager must create reimburse-zero-demo-leader as a dedicated TeamLeader Worker."
    },
    "team_leader": {
      "id": "reimburse_zero_demo_leader",
      "name": "reimburse-zero-demo-leader",
      "creation": "created by manager during Team creation",
      "rule": "Must be created as a new independent Worker and designated as TeamLeader. Do not designate any business Worker as leader."
    },
    "agent_spec_source": "inline messages in at/create_agents_messages.md",
    "incident_task_source": "three separate claim messages in at/run_demo_task_message.md",
    "task_submission_policy": {
      "room": "Matrix room whose name starts with Team and matches reimburse-zero-demo",
      "mention": "@<team_leader_name>",
      "rule": "Enter the Team room, mention the team leader, paste one claim task into that mention message, and wait for the report before submitting the next claim."
    },
    "tool_gateway": {
      "transport": "http",
      "base_url": "http://<TOOL_HOST_REACHABLE_BY_WORKER>:18089",
      "call_pattern": "POST /tools/{scenario_id}/{tool_name}.{function_name}"
    }
  },
  "agents": [
    {
      "id": "intake",
      "name": "Intake 单据接收 Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/intake/Agent.md",
      "skills": ["doc-extract", "duplicate-check"],
      "tools": ["mock_claim.get_claim", "mock_claim.list_history"]
    },
    {
      "id": "audit_analyst",
      "name": "稽核 Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/audit-analyst/Agent.md",
      "skills": ["invoice-verify", "policy-rag", "duplicate-check", "impact-assess"],
      "tools": ["mock_invoice.verify", "mock_policy.search", "mock_claim.list_history"]
    },
    {
      "id": "risk_rater",
      "name": "风险评级 Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/risk-rater/Agent.md",
      "skills": ["risk-assess", "approval-guard"],
      "tools": ["mock_policy.search", "mock_approval.create_approval_task"]
    },
    {
      "id": "executor",
      "name": "处置 Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/executor/Agent.md",
      "skills": ["payment-verify", "approval-guard"],
      "tools": ["mock_payment.execute", "mock_payment.rollback", "mock_ledger.post_entry", "mock_ledger.verify_entry"]
    },
    {
      "id": "reviewer",
      "name": "复盘 Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/reviewer/Agent.md",
      "skills": ["audit-report", "data-query"],
      "tools": ["mock_ledger.verify_entry", "mock_policy.search"]
    }
  ],
  "workflow": [
    {"step": 1, "agent": "reimburse_zero_demo_leader", "task": "team_leader_receives_claim_and_dispatches_workers"},
    {"step": 2, "agent": "intake", "task": "parse_and_dedupe_claim"},
    {"step": 3, "agent": "audit_analyst", "task": "verify_invoice_and_policy_compliance"},
    {"step": 4, "agent": "risk_rater", "task": "rate_risk_and_decide_disposition"},
    {"step": 5, "agent": "executor", "task": "execute_payment_or_return_with_approval_gate"},
    {"step": 6, "agent": "reviewer", "task": "generate_audit_report_and_rule_suggestions"},
    {"step": 7, "agent": "reimburse_zero_demo_leader", "task": "compose_final_claim_report"}
  ],
  "risk_policy": {
    "auto_execute": ["L0", "L1"],
    "approval_only": ["L2", "L3"],
    "payment_approval_required": true,
    "note": "Payment is ALWAYS approval-gated. AI never makes the final fund decision."
  }
}
